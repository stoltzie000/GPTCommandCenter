APP_MODE=local
AUTH_MODE=disabled
PORT=8080
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
ORCHESTRATOR_API_TOKEN=
WORKSPACE_ROOT=C:\\Projects\\GPTCommandCenter\\workspaces
ALLOWED_REPOSITORIES=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CODEX_COMMAND=codex

# Specialist inventory
# none = inventory verification disabled
# file = load authoritative discovery input from a local JSON file
SPECIALIST_INVENTORY_PROVIDER=none
# Required when SPECIALIST_INVENTORY_PROVIDER=file
# SPECIALIST_INVENTORY_FILE=/absolute/path/to/specialist-inventory.json
